APP_NAME="DeployOps AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://deployops-ai.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Operational database (MySQL recommended for local dev with Laravel Herd)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deployops
DB_USERNAME=root
DB_PASSWORD=

# PostgreSQL (pgvector) is provisioned via docker-compose for the AI service RAG store.
# It is NOT the Laravel application database. Configure in ai-service/.env instead.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@deployops.ai"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://deployops-ai.test

# AI service (FastAPI) — Laravel proxies copilot/RAG requests here
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT=60
AI_SERVICE_CONNECT_TIMEOUT=5

# Knowledge document upload limits
KNOWLEDGE_MAX_FILE_SIZE_KB=10240
KNOWLEDGE_DEFAULT_TOP_K=5
KNOWLEDGE_MAX_TOP_K=20

# OpenAI (used by ai-service; set in ai-service/.env for local dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=30
OPENAI_CONNECT_TIMEOUT=5
OPENAI_MAX_OUTPUT_TOKENS=800

# Portfolio demo data (never seeded when APP_ENV=production)
SEED_DEMO_DATA=false
